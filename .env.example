# System Environment Variables
PROJECT_NAME="Hospital Network Configuration Drift Sentinel"
SECRET_KEY="hospital-drift-sentinel-super-secret-key-for-jwt-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database
# Use SQLite locally: sqlite:///./hospital_drift.db
# Or PostgreSQL: postgresql://postgres:postgres@localhost:5432/hospital_drift
DATABASE_URL="sqlite:///./hospital_drift.db"

# Risk Thresholds
CRITICAL_THRESHOLD=75
HIGH_THRESHOLD=50
MEDIUM_THRESHOLD=25

# ML Model Paths
ML_MODEL_DIR="./ml_models"
DATA_DIR="./data"
